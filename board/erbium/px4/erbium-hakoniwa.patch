+++ b/boards/aifoundry/erbium/init/rc.board_sensors
@@ -2,3 +2,10 @@
 #
 # AIFoundry Erbium specific board sensors init
 #------------------------------------------------------------------------------
+
+# aifoundry_erbium_hakoniwa: IMU, magnetometer, barometer and GPS of Athrill's
+# Hakoniwa sensor device.
+if [ -e /bin/hako_sensor_device ]
+then
+	hako_sensor_device start
+fi
