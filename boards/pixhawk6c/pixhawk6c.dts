/*
 * Athrill Holybro Pixhawk 6C / FMUv6C V6C00 board description.
 *
 * SoC description: Zephyr stm32h743Xi.dtsi, Apache-2.0, through
 * stm32h743-athrill.dtsi at revision
 * f3fc249035296b87c75fa808b3abf78829fe9378.
 *
 * Board wiring facts (no source code copied) come from the BSD-3-Clause
 * PX4-Autopilot v1.17.0 files:
 *   boards/px4/fmu-v6c/src/spi.cpp
 *   boards/px4/fmu-v6c/src/i2c.cpp
 *   boards/px4/fmu-v6c/src/timer_config.cpp
 *   boards/px4/fmu-v6c/init/rc.board_sensors
 *   boards/px4/fmu-v6c/default.px4board
 *   boards/px4/fmu-v6c/nuttx-config/nsh/defconfig
 *   boards/px4/fmu-v6c/nuttx-config/include/board.h
 *   boards/px4/fmu-v6c/nuttx-config/include/board_dma_map.h
 *   boards/px4/fmu-v6c/src/board_config.h
 *   src/drivers/uavcan/uavcan_drivers/stm32h7/driver/src/uc_stm32h7_clock.cpp
 */

/dts-v1/;

#include "stm32h743-athrill.dtsi"
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/dma/stm32_dma.h>

/ {
	model = "Holybro Pixhawk 6C (FMUv6C V6C00) for Athrill";
	compatible = "holybro,pixhawk6c", "st,stm32h743";

	aliases {
		gnss0 = &gps1;
	};

	/* The values of the chips, the GPS and the actuator outputs when no
	 * simulator feeds them: constant, or the bench at Tokyo Station with
	 * DEVICE_CONFIG_STM32_SENSOR_BENCH 1 (athrill-device
	 * src/models/bench_sensor.c). The Hakoniwa board file points them at
	 * the Hakoniwa sensor device instead. */
	bench_sensor: bench-sensor-source {
		compatible = "athrill,bench-sensor-source";
	};

	hakoniwa_sensor: sensor-device {
		compatible = "hakoniwa,sensor-device";
		status = "disabled";
	};

	/* FMU outputs 1..8 in firmware output order. */
	pwm_actuators: pwm-actuator-map {
		compatible = "athrill,pwm-actuator-map";
		pwms = <&pwm1 1 20000000 0>,
		       <&pwm1 2 20000000 0>,
		       <&pwm1 3 20000000 0>,
		       <&pwm1 4 20000000 0>,
		       <&pwm4 3 20000000 0>,
		       <&pwm4 4 20000000 0>,
		       <&pwm5 1 20000000 0>,
		       <&pwm5 2 20000000 0>;
		pwm-names = "FMU_CH1", "FMU_CH2", "FMU_CH3", "FMU_CH4",
			    "FMU_CH5", "FMU_CH6", "FMU_CH7", "FMU_CH8";
		athrill,output-pins = "PA8", "PE11", "PE13", "PE14",
				      "PD14", "PD15", "PA0", "PA1";
	};

	soc {
		/* Boot-time H743 fabric registers not described by the upstream DTSI. */
		syscfg: system-config@58000400 {
			compatible = "st,stm32h7-syscfg";
			reg = <0x58000400 0x400>;
		};
	};
};

/* FMUv6C allocates transfers on DMA1/2; startup also resets BDMA/DMAMUX2. */
&dma1 { status = "okay"; };
&dma2 { status = "okay"; };
&dmamux1 { status = "okay"; };
&bdma1 { status = "okay"; };
&dmamux2 { status = "okay"; };

/* Boot-time peripherals touched by PX4 or ArduPilot on this board. */
&adc12_common { status = "okay"; };
&adc1 { status = "okay"; };
&adc3_common { status = "okay"; };
&adc3 { status = "okay"; };
&rng { status = "okay"; };
&rtc { status = "okay"; };
&iwdg { status = "okay"; };
&usbotg_fs { status = "okay"; };
&fdcan1 {
	status = "okay";
	/* STM32H743 FDCAN1 registers plus the shared 2560-word message RAM. */
	reg = <0x4000a000 0x400>, <0x4000ac00 0x2800>;
};
&fdcan2 {
	status = "okay";
	/* The shared message RAM is owned by fdcan1 above. */
	reg = <0x4000a400 0x400>;
};

/*
 * DMA request wiring (dmas): the DMAMUX1 request line of each peripheral
 * (RM0433, the DMAMUX1 input assignment table). DMAMUX1 routes a request to any
 * DMA1/DMA2 stream the firmware selects, so the channel cell (0) is not a
 * wiring fact: the routing is the firmware's DMAMUX setting.
 */

/* V6C00 internal sensor bus: accel PC15, gyro PC14, ICM PC13. */
&spi1 {
	status = "okay";
	cs-gpios = <&gpioc 15 GPIO_ACTIVE_LOW>,
		   <&gpioc 14 GPIO_ACTIVE_LOW>,
		   <&gpioc 13 GPIO_ACTIVE_LOW>;
	dmas = <&dmamux1 0 38 STM32_DMA_PERIPH_TX>,
	       <&dmamux1 0 37 STM32_DMA_PERIPH_RX>;
	dma-names = "tx", "rx";

	bmi055_accel: accelerometer@0 {
		compatible = "bosch,bma280";
		reg = <0>;
		spi-max-frequency = <10000000>;
		int-gpios = <&gpioe 4 GPIO_ACTIVE_HIGH>;
		athrill,mount-rotation = "yaw-180";
	};

	bmi055_gyro: gyroscope@1 {
		compatible = "bosch,bmg160";
		reg = <1>;
		spi-max-frequency = <10000000>;
		int-gpios = <&gpioe 5 GPIO_ACTIVE_HIGH>;
		athrill,mount-rotation = "yaw-180";
	};

	icm42688p: imu@2 {
		compatible = "invensense,icm42688", "invensense,icm4268x";
		reg = <2>;
		spi-max-frequency = <24000000>;
		int-gpios = <&gpioe 6 GPIO_ACTIVE_HIGH>;
		athrill,mount-rotation = "yaw-270";
	};
};

/* Parameter F-RAM on SPI2, CS PD4. */
&spi2 {
	status = "okay";
	cs-gpios = <&gpiod 4 GPIO_ACTIVE_LOW>;
	dmas = <&dmamux1 0 40 STM32_DMA_PERIPH_TX>,
	       <&dmamux1 0 39 STM32_DMA_PERIPH_RX>;
	dma-names = "tx", "rx";

	fram: fram@0 {
		compatible = "infineon,fm25xxx";
		reg = <0>;
		spi-max-frequency = <20000000>;
		size = <32768>;
	};
};

/*
 * The external I2C buses PX4 v1.17.0 scans on FMUv6C (i2c.cpp: external 1,
 * 2, 4), with nothing on them; I2C4 below carries the internal chips.
 */
&i2c1 { status = "okay"; };
&i2c2 { status = "okay"; };

/* V6C00 internal barometer and magnetometer are on I2C4. */
&i2c4 {
	status = "okay";

	barometer: pressure@77 {
		compatible = "meas,ms5611";
		reg = <0x77>;
	};

	magnetometer: magnetometer@c {
		compatible = "isentek,ist8310";
		reg = <0x0c>;
		athrill,mount-rotation = "none";
	};
};

/*
 * The other USART/UARTs PX4 v1.17.0 enables on FMUv6C (nuttx-config/nsh/
 * defconfig: USART2, USART3 (the console), UART5, USART6, UART7, UART8),
 * with nothing on them.
 */
&usart2 {
	status = "okay";
	dmas = <&dmamux1 0 44 STM32_DMA_PERIPH_TX>,
	       <&dmamux1 0 43 STM32_DMA_PERIPH_RX>;
	dma-names = "tx", "rx";
};
&usart3 {
	status = "okay";
	dmas = <&dmamux1 0 46 STM32_DMA_PERIPH_TX>,
	       <&dmamux1 0 45 STM32_DMA_PERIPH_RX>;
	dma-names = "tx", "rx";
};
&uart5 {
	status = "okay";
	dmas = <&dmamux1 0 66 STM32_DMA_PERIPH_TX>,
	       <&dmamux1 0 65 STM32_DMA_PERIPH_RX>;
	dma-names = "tx", "rx";
};
&usart6 {
	status = "okay";
	dmas = <&dmamux1 0 72 STM32_DMA_PERIPH_TX>,
	       <&dmamux1 0 71 STM32_DMA_PERIPH_RX>;
	dma-names = "tx", "rx";
};
&uart7 {
	status = "okay";
	dmas = <&dmamux1 0 80 STM32_DMA_PERIPH_TX>,
	       <&dmamux1 0 79 STM32_DMA_PERIPH_RX>;
	dma-names = "tx", "rx";
};
&uart8 {
	status = "okay";
	dmas = <&dmamux1 0 82 STM32_DMA_PERIPH_TX>,
	       <&dmamux1 0 81 STM32_DMA_PERIPH_RX>;
	dma-names = "tx", "rx";
};

/* GPS1 is /dev/ttyS0. */
&usart1 {
	status = "okay";
	current-speed = <57600>;
	dmas = <&dmamux1 0 42 STM32_DMA_PERIPH_TX>,
	       <&dmamux1 0 41 STM32_DMA_PERIPH_RX>;
	dma-names = "tx", "rx";

	gps1: gnss {
		compatible = "u-blox,m8";
		initial-baudrate = <9600>;
		fix-rate = <200>;
	};
};

&sdmmc2 {
	status = "okay";
	bus-width = <4>;

	sdcard: sd-card {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

/*
 * TIM1 drives motors 1-4 (CH1-CH4). For DShot, PX4 v1.17.0 (timer_config.cpp
 * DMA{Index1}, dshot.c) bursts CCR1-CCR4 through DMAR on the update DMA
 * request, routed by DMAMUX1 (request 15, TIM1_UP; RM0433 DMAMUX1 table) to a
 * DMA1 stream it allocates. The configuration cell is PX4's stream setup
 * (32-bit memory to peripheral, high priority). With PWM PX4 never sets UDE,
 * so the request is never raised.
 */
&timers1 {
	status = "okay";
	dmas = <&dmamux1 0 15 (STM32_DMA_PERIPH_TX | STM32_DMA_MEM_32BITS |
			       STM32_DMA_PERIPH_32BITS | STM32_DMA_PRIORITY_HIGH)>;
	dma-names = "up";
	pwm1: pwm { status = "okay"; };
};

&timers4 {
	status = "okay";
	pwm4: pwm { status = "okay"; };
};

&timers5 {
	status = "okay";
	pwm5: pwm { status = "okay"; };
};

/* Keep H743-only allocation visible, including the corrected IRQs. */
&timers15 { status = "okay"; };
&timers16 { status = "okay"; };
&timers17 { status = "okay"; };

/*
 * The other timers PX4 v1.17.0 drives on FMUv6C (board_config.h,
 * uc_stm32h7_clock.cpp): TIM2 is the UAVCAN clock, TIM3 the tone alarm
 * (TONE_ALARM_TIMER 3) and TIM8 the HRT (HRT_TIMER 8).
 */
&timers2 { status = "okay"; };
&timers3 { status = "okay"; };
&timers8 { status = "okay"; };

/* Their values: the bench sensor source above. */
&pwm_actuators { value-source = <&bench_sensor>; };
&bmi055_accel { value-source = <&bench_sensor>; };
&bmi055_gyro { value-source = <&bench_sensor>; };
&icm42688p { value-source = <&bench_sensor>; };
&barometer { value-source = <&bench_sensor>; };
&magnetometer { value-source = <&bench_sensor>; };
&gps1 { value-source = <&bench_sensor>; };
