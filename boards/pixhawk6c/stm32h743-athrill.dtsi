/*
 * Athrill's STM32H743Xi SoC layer.  The register ranges, interrupts, clocks,
 * resets and controller instances come from Zephyr's stm32h743Xi.dtsi at
 * f3fc249035296b87c75fa808b3abf78829fe9378.  Keeping this small include
 * layer separate makes the upstream Apache-2.0 provenance explicit while
 * the MIT board file below contains only Pixhawk 6C wiring.
 */
#include <st/h7/stm32h743Xi.dtsi>

/*
 * The generic STM32 timer compatible is shared with F7, but H743 runs every
 * enabled timer kernel at 240 MHz from a 480 MHz CPU.  Mark the instances so
 * the common model selects the H7 clock/IRQ table instead of the F7 table.
 */
&timers1 { athrill,stm32h7-timer; };
&timers2 { athrill,stm32h7-timer; };
&timers3 { athrill,stm32h7-timer; };
&timers4 { athrill,stm32h7-timer; };
&timers5 { athrill,stm32h7-timer; };
&timers6 { athrill,stm32h7-timer; };
&timers7 { athrill,stm32h7-timer; };
&timers8 { athrill,stm32h7-timer; };
&timers12 { athrill,stm32h7-timer; };
&timers13 { athrill,stm32h7-timer; };
&timers14 { athrill,stm32h7-timer; };
&timers15 { athrill,stm32h7-timer; };
&timers16 { athrill,stm32h7-timer; };
&timers17 { athrill,stm32h7-timer; };

/*
 * The USART/UART compatibles are shared with F7 too, but every H743 USART
 * runs from D2PCLK (120 MHz, CPU / 4).  Mark the instances so the model takes
 * the H7 kernel clock divider instead of the F7 one.
 */
&usart1 { athrill,stm32h7-uart; };
&usart2 { athrill,stm32h7-uart; };
&usart3 { athrill,stm32h7-uart; };
&uart4 { athrill,stm32h7-uart; };
&uart5 { athrill,stm32h7-uart; };
&usart6 { athrill,stm32h7-uart; };
&uart7 { athrill,stm32h7-uart; };
&uart8 { athrill,stm32h7-uart; };
