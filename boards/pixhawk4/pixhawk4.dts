/* SPDX-License-Identifier: MIT */

/*
 * Athrill Pixhawk 4 / FMUv5 board description.
 *
 * SoC description: Zephyr stm32f765Xi.dtsi, Apache-2.0.
 * Board wiring facts (no PX4 source code copied):
 *   PX4-Autopilot boards/px4/fmu-v5/src/spi.cpp
 *   PX4-Autopilot boards/px4/fmu-v5/src/i2c.cpp
 *   PX4-Autopilot boards/px4/fmu-v5/src/timer_config.cpp
 *   PX4-Autopilot boards/px4/fmu-v5/init/rc.board_sensors
 *   PX4-Autopilot boards/px4/fmu-v5/default.px4board
 *   PX4-Autopilot boards/px4/fmu-v5/nuttx-config/nsh/defconfig
 *   PX4-Autopilot boards/px4/fmu-v5/nuttx-config/include/board.h
 *   PX4-Autopilot boards/px4/fmu-v5/src/board_config.h
 *   PX4-Autopilot boards/px4/fmu-v5/nuttx-config/include/board_dma_map.h
 *   PX4-Autopilot src/drivers/uavcan/uavcan_drivers/stm32/driver/src/uc_stm32_clock.cpp
 * Those PX4 files are BSD-3-Clause.  This file records the V500 baseline
 * devices currently instantiated by Athrill, not every alternate hardware
 * revision or unmodelled external connector.
 */

/dts-v1/;

#include "stm32f765-athrill.dtsi"
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/dma/stm32_dma.h>
#include <zephyr/dt-bindings/sensor/sensor_axis_align.h>

/ {
	model = "Holybro Pixhawk 4 (FMUv5) for Athrill";
	compatible = "holybro,pixhawk4", "st,stm32f765";

	aliases {
		gnss0 = &gps1;
	};

	soc {
		syscfg: system-config@40013800 {
			compatible = "st,stm32f7-syscfg";
			reg = <0x40013800 0x400>;
		};
	};

	/* The values of the chips, the GPS and the actuator outputs when no
	 * simulator feeds them: constant, or the bench at Tokyo Station with
	 * DEVICE_CONFIG_STM32_SENSOR_BENCH 1 (athrill-device
	 * src/models/bench_sensor.c). The Hakoniwa board file points them at
	 * the Hakoniwa sensor device instead. */
	bench_sensor: bench-sensor-source {
		compatible = "athrill,bench-sensor-source";
	};

	hakoniwa_sensor: sensor-device {
		compatible = "hakoniwa,sensor-device";
		status = "disabled";
	};

	/*
	 * Ordered FMU outputs 1..8.  The order, not the node declaration order,
	 * is the actuator order consumed by Athrill.
	 */
	pwm_actuators: pwm-actuator-map {
		compatible = "athrill,pwm-actuator-map";
		pwms = <&pwm1 4 20000000 0>,
		       <&pwm1 3 20000000 0>,
		       <&pwm1 2 20000000 0>,
		       <&pwm1 1 20000000 0>,
		       <&pwm4 2 20000000 0>,
		       <&pwm4 3 20000000 0>,
		       <&pwm12 1 20000000 0>,
		       <&pwm12 2 20000000 0>;
		pwm-names = "FMU_CH1", "FMU_CH2", "FMU_CH3", "FMU_CH4",
			    "FMU_CH5", "FMU_CH6", "FMU_CH7", "FMU_CH8";
		athrill,output-pins = "PE14", "PA10", "PE11", "PE9",
				      "PD13", "PD14", "PH6", "PH9";
	};
};

/*
 * DMA request wiring (dmas): every DMA1/DMA2 stream and channel each
 * peripheral's request reaches on the STM32F76x (RM0410, the DMA1/DMA2
 * request mapping tables), so a firmware may take any of them. A name appears once
 * per stream that request reaches. Where PX4 v1.17.0 uses DMA on FMUv5
 * (nuttx-config/include/board_dma_map.h), its stream is the first tuple of
 * that name.
 */

/* SPI1 sensor bus: ICM-20689 CS PF2, DRDY PB4, PX4 rotation 2 (yaw 90). */
&spi1 {
	status = "okay";
	cs-gpios = <&gpiof 2 GPIO_ACTIVE_LOW>;
	dmas = <&dma2 3 3 STM32_DMA_PERIPH_TX STM32_DMA_FIFO_FULL>,
	       <&dma2 0 3 STM32_DMA_PERIPH_RX STM32_DMA_FIFO_FULL>,
	       <&dma2 5 3 STM32_DMA_PERIPH_TX STM32_DMA_FIFO_FULL>,
	       <&dma2 2 3 STM32_DMA_PERIPH_RX STM32_DMA_FIFO_FULL>;
	dma-names = "tx", "rx", "tx", "rx";

	icm20689: imu@0 {
		compatible = "invensense,icm20689";
		reg = <0>;
		spi-max-frequency = <8000000>;
		int-gpios = <&gpiob 4 GPIO_ACTIVE_HIGH>;
		axis-align-x = <SENSOR_AXIS_ALIGN_DT_Y>;
		axis-align-x-sign = <SENSOR_AXIS_ALIGN_DT_NEG>;
		axis-align-y = <SENSOR_AXIS_ALIGN_DT_X>;
		axis-align-y-sign = <SENSOR_AXIS_ALIGN_DT_POS>;
		axis-align-z = <SENSOR_AXIS_ALIGN_DT_Z>;
	};
};

/* SPI2 parameter F-RAM: FM25V02 (256 Kbit / 32768 bytes), CS PF5. */
&spi2 {
	status = "okay";
	cs-gpios = <&gpiof 5 GPIO_ACTIVE_LOW>;
	dmas = <&dma1 4 0 STM32_DMA_PERIPH_TX STM32_DMA_FIFO_FULL>,
	       <&dma1 3 0 STM32_DMA_PERIPH_RX STM32_DMA_FIFO_FULL>,
	       <&dma1 6 9 STM32_DMA_PERIPH_TX STM32_DMA_FIFO_FULL>,
	       <&dma1 1 9 STM32_DMA_PERIPH_RX STM32_DMA_FIFO_FULL>;
	dma-names = "tx", "rx", "tx", "rx";

	fram: fram@0 {
		compatible = "infineon,fm25xxx";
		reg = <0>;
		spi-max-frequency = <20000000>;
		size = <32768>;
	};
};

/*
 * The external I2C buses PX4 v1.17.0 scans on FMUv5 (i2c.cpp: external 4,
 * 2, 1; internal 3), with nothing on them.
 */
&i2c1 { status = "okay"; };
&i2c2 { status = "okay"; };
&i2c4 { status = "okay"; };

/* I2C3 internal IST8310 at its default 0x0e address, PX4 rotation 10. */
&i2c3 {
	status = "okay";

	magnetometer: magnetometer@e {
		compatible = "isentek,ist8310";
		reg = <0x0e>;
		athrill,mount-rotation = "roll-180-yaw-90";
	};
};

/* SPI4 internal MS5611 barometer, CS PF10. */
&spi4 {
	status = "okay";
	cs-gpios = <&gpiof 10 GPIO_ACTIVE_LOW>;
	dmas = <&dma2 1 4 STM32_DMA_PERIPH_TX STM32_DMA_FIFO_FULL>,
	       <&dma2 0 4 STM32_DMA_PERIPH_RX STM32_DMA_FIFO_FULL>,
	       <&dma2 4 5 STM32_DMA_PERIPH_TX STM32_DMA_FIFO_FULL>,
	       <&dma2 3 5 STM32_DMA_PERIPH_RX STM32_DMA_FIFO_FULL>,
	       <&dma2 2 9 STM32_DMA_PERIPH_TX STM32_DMA_FIFO_FULL>;
	dma-names = "tx", "rx", "tx", "rx", "tx";

	barometer: pressure@0 {
		compatible = "meas,ms5611";
		reg = <0>;
		spi-max-frequency = <20000000>;
	};
};

/* GPS1 is /dev/ttyS0 (USART1): PX4 fmu-v5/default.px4board and board.h. */
/*
 * The other USART/UARTs PX4 v1.17.0 enables on FMUv5 (nuttx-config/nsh/
 * defconfig: USART2, USART3, UART4, USART6, UART7 (the console), UART8),
 * with nothing on them.
 */
&usart2 {
	status = "okay";
	dmas = <&dma1 6 4 STM32_DMA_PERIPH_TX STM32_DMA_FIFO_FULL>,
	       <&dma1 5 4 STM32_DMA_PERIPH_RX STM32_DMA_FIFO_FULL>;
	dma-names = "tx", "rx";
};
&usart3 {
	status = "okay";
	dmas = <&dma1 3 4 STM32_DMA_PERIPH_TX STM32_DMA_FIFO_FULL>,
	       <&dma1 1 4 STM32_DMA_PERIPH_RX STM32_DMA_FIFO_FULL>,
	       <&dma1 4 7 STM32_DMA_PERIPH_TX STM32_DMA_FIFO_FULL>;
	dma-names = "tx", "rx", "tx";
};
&uart4 {
	status = "okay";
	dmas = <&dma1 4 4 STM32_DMA_PERIPH_TX STM32_DMA_FIFO_FULL>,
	       <&dma1 2 4 STM32_DMA_PERIPH_RX STM32_DMA_FIFO_FULL>;
	dma-names = "tx", "rx";
};
&usart6 {
	status = "okay";
	dmas = <&dma2 6 5 STM32_DMA_PERIPH_TX STM32_DMA_FIFO_FULL>,
	       <&dma2 2 5 STM32_DMA_PERIPH_RX STM32_DMA_FIFO_FULL>,
	       <&dma2 7 5 STM32_DMA_PERIPH_TX STM32_DMA_FIFO_FULL>,
	       <&dma2 1 5 STM32_DMA_PERIPH_RX STM32_DMA_FIFO_FULL>;
	dma-names = "tx", "rx", "tx", "rx";
};
&uart7 {
	status = "okay";
	dmas = <&dma1 1 5 STM32_DMA_PERIPH_TX STM32_DMA_FIFO_FULL>,
	       <&dma1 3 5 STM32_DMA_PERIPH_RX STM32_DMA_FIFO_FULL>;
	dma-names = "tx", "rx";
};
&uart8 {
	status = "okay";
	dmas = <&dma1 0 5 STM32_DMA_PERIPH_TX STM32_DMA_FIFO_FULL>,
	       <&dma1 6 5 STM32_DMA_PERIPH_RX STM32_DMA_FIFO_FULL>;
	dma-names = "tx", "rx";
};

&usart1 {
	status = "okay";
	current-speed = <57600>;
	dmas = <&dma2 7 4 STM32_DMA_PERIPH_TX STM32_DMA_FIFO_FULL>,
	       <&dma2 5 4 STM32_DMA_PERIPH_RX STM32_DMA_FIFO_FULL>,
	       <&dma2 2 4 STM32_DMA_PERIPH_RX STM32_DMA_FIFO_FULL>;
	dma-names = "tx", "rx", "rx";

	gps1: gnss {
		compatible = "u-blox,m8";
		initial-baudrate = <9600>;
		fix-rate = <200>;
	};
};

/* SDMMC1: CK PC12, CMD PD2, D0..D3 PC8..PC11, card detect PG0. */
&sdmmc1 {
	status = "okay";
	bus-width = <4>;
	cd-gpios = <&gpiog 0 GPIO_ACTIVE_LOW>;
	/* D0 (PC8) as the firmware reads it as a GPIO: high through the
	 * board's pull-up while the card is not busy. */
	athrill,d0-gpios = <&gpioc 8 GPIO_ACTIVE_HIGH>;
	/* The F7 controller changes the direction of its one allocated stream. */
	dmas = <&dma2 6 4 (STM32_DMA_PERIPH_RX | STM32_DMA_32BITS) STM32_DMA_FIFO_FULL>,
	       <&dma2 6 4 (STM32_DMA_PERIPH_TX | STM32_DMA_32BITS) STM32_DMA_FIFO_FULL>,
	       <&dma2 3 4 (STM32_DMA_PERIPH_RX | STM32_DMA_32BITS) STM32_DMA_FIFO_FULL>,
	       <&dma2 3 4 (STM32_DMA_PERIPH_TX | STM32_DMA_32BITS) STM32_DMA_FIFO_FULL>;
	dma-names = "rx", "tx", "rx", "tx";

	sdcard: sd-card {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

/* Start-up peripherals PX4 v1.17.0 touches on FMUv5 (RTC, the ADC block,
 * USB OTG FS, CAN1, the backup SRAM): register blocks with the SoC layer's
 * read rules. */
&rtc { status = "okay"; };
&adc123_common { status = "okay"; };
&usbotg_fs { status = "okay"; };
&can1 { status = "okay"; };
&backup_sram { status = "okay"; };
/* The independent watchdog ArduPilot sets up (PX4 leaves it). */
&iwdg { status = "okay"; };

&dma1 {
	status = "okay";
};

&dma2 {
	status = "okay";
};

&timers1 {
	status = "okay";
	pwm1: pwm {
		status = "okay";
	};
};

&timers4 {
	status = "okay";
	pwm4: pwm {
		status = "okay";
	};
};

&timers12 {
	status = "okay";
	pwm12: pwm {
		status = "okay";
	};
};

/*
 * The other timers PX4 v1.17.0 drives on FMUv5 (board_config.h,
 * timer_config.cpp, uc_stm32_clock.cpp): TIM2 is an input-capture I/O
 * timer, TIM5 the UI LED PWM, TIM6 the UAVCAN clock, TIM8 the HRT
 * (HRT_TIMER 8) and TIM9 the tone alarm (TONE_ALARM_TIMER 9).
 */
&timers2 { status = "okay"; };
&timers5 { status = "okay"; };
&timers6 { status = "okay"; };
&timers8 { status = "okay"; };
&timers9 { status = "okay"; };

/* Their values: the bench sensor source above. */
&pwm_actuators { value-source = <&bench_sensor>; };
&icm20689 { value-source = <&bench_sensor>; };
&magnetometer { value-source = <&bench_sensor>; };
&barometer { value-source = <&bench_sensor>; };
&gps1 { value-source = <&bench_sensor>; };
